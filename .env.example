# Configurações do Google Cloud / Firebase
FIREBASE_PROJECT_ID=a7system
FIREBASE_STORAGE_BUCKET=a7system.appspot.com
GCP_REGION=southamerica-east1

# Configurações do Frontend (Firebase SDK)
FIREBASE_API_KEY=sua_api_key_aqui
FIREBASE_AUTH_DOMAIN=a7system.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=seu_sender_id_aqui
FIREBASE_APP_ID=seu_app_id_aqui

# App Check / Segurança
RECAPTCHA_SITE_KEY=sua_recaptcha_key_aqui

# Configurações do Backend
SECRET_KEY=sua_secret_key_super_segura_aqui
CORS_ORIGINS=http://localhost:5000,https://a7system-app.web.app
LOG_LEVEL=INFO
