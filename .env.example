# Configurações do Banco de Dados PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres.XXXXX:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase API
SUPABASE_URL=https://XXXXX.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui

# Autenticação e Segurança JWT
SECRET_KEY=sua_secret_key_super_segura_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Configurações do Servidor
PORT=8080
CORS_ORIGINS=http://localhost:5000,http://localhost:8080,http://127.0.0.1:5000,http://127.0.0.1:8080
LOG_LEVEL=INFO
